{
  "name": "aether-frontend",
  "version": "2.0.0",
  "description": "Ripple \u2014 the streaming and creation platform for original AI entertainment.",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "dev": "expo start --web",
    "web": "expo start --web",
    "prebuild": "node scripts/validate-production-env.js",
    "build": "expo export --platform web --output-dir dist && node scripts/fix-web-document.js",
    "build:web": "npm run build",
    "preview": "npx serve dist",
    "check": "npx expo-doctor",
    "test": "node --test *.test.js",
    "android": "expo run:android",
    "android:prebuild": "expo prebuild --platform android",
    "build:android:development": "eas build --platform android --profile development",
    "build:android:preview": "eas build --platform android --profile preview",
    "build:android:production": "eas build --platform android --profile production"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "expo": "~54.0.0",
    "expo-linear-gradient": "~15.0.8",
    "expo-secure-store": "~15.0.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "npm:react-native-tvos@0.81.5-0",
    "react-native-web": "0.21.0"
  }
}
